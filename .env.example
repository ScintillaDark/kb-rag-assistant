# Copy to .env and adjust. Every value is optional; defaults are shown.

# ── Branding (shown in the UI, prompts and API title) ────────────────────────
APP_NAME=KnowledgeBase Assistant
APP_TAGLINE=Ask anything about the documentation. Answers run on a local LLM.
APP_INPUT_PLACEHOLDER=Ask a question...
# Paths are relative to the project root (or absolute)
APP_ICON_PATH=assets/kb-icon.png
APP_LOGO_PATH=assets/kb-logo.svg

# ── Knowledge-base subject area (used in prompts and the scope guardrail) ────
KB_DOMAIN=the documentation in the knowledge base
# Comma-separated list of topics covered
KB_TOPICS=
# "|"-separated suggested questions shown on the empty chat screen.
# Leave empty to use the built-in sample questions.
KB_SUGGESTED_QUESTIONS=
# Extra "|"-separated questions for scripts/warm_cache.py
KB_WARM_QUESTIONS=

# ── Crawler (only needed to index a website with scripts/sync_kb.sh) ─────────
KB_BASE_URL=
KB_ROOT_URL=
# URL segments below the KB root that identify article and listing pages
KB_ARTICLE_SEGMENT=detail
KB_LISTING_SEGMENT=product
KB_USER_AGENT=KBAssistant-Crawler/1.0 (+offline rag demo)

# ── Runtime API / retrieval ──────────────────────────────────────────────────
RAG_INDEX_DIR=data/index
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.32
RAG_MIN_SOURCES=2
RAG_RESPONSE_CACHE_TTL_SECONDS=900
RAG_RESPONSE_CACHE_MAX_ENTRIES=128
RAG_CLARIFICATION_ENABLED=true
RAG_ANSWER_OPTIONS_ENABLED=true

# ── Local Ollama ─────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:latest
# Max seconds to wait for the model between tokens
OLLAMA_TIMEOUT=600
# Let reasoning models (e.g. gemma4, qwen3) "think" before answering. Much slower on CPU.
OLLAMA_THINK=false

# ── Optional web search fallback (off by default) ────────────────────────────
WEB_SEARCH_ENABLED=false
WEB_SEARCH_MAX_RESULTS=4

# ── Scope guardrail (adds one small LLM call per question) ───────────────────
GUARDRAIL_ENABLED=false
GUARDRAIL_MODEL=gemma4:latest
GUARDRAIL_TIMEOUT=15

# ── Services (used by start.sh) ──────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000
UI_PORT=8501
RAG_API_URL=http://127.0.0.1:8000/chat
